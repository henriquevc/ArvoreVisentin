# Configurações do Banco de Dados Turso (SQLite na nuvem)
# Crie seu banco grátis em https://turso.tech e cole os valores abaixo:
TURSO_DATABASE_URL=libsql://seu-banco-aqui.turso.io
TURSO_AUTH_TOKEN=seu-token-aqui

# Senha para liberar adição, edição e exclusão de membros no site:
EDIT_PASSWORD=escolha-uma-senha-aqui
